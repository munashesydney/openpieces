# Dockerfile for pgvector database with automatic extension initialization
# Extends the official pgvector image so the vector extension is created on first startup
FROM pgvector/pgvector:pg16

# Copy init scripts that run during database initialization (first run only)
# These ensure vector extension exists before migrations run
# We copy only scripts that are meant for initialization (numbered ones)
COPY db-init/001-*.sh /docker-entrypoint-initdb.d/
RUN chmod +x /docker-entrypoint-initdb.d/*.sh

# Copy and set custom entrypoint for environment validation
COPY db-init/db-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/db-entrypoint.sh
ENTRYPOINT ["db-entrypoint.sh"]
CMD ["postgres"]
