# Copy this file to .env and fill in the values
# cp .env.example .env

# =============================================================================
# Database mode
#
# • Bundled Postgres (default):  local db container always starts with the compose
# • External Postgres:            set DATABASE_URL to your connection string,
#                                  and remove the `db` service from docker-compose.prod.yml
# =============================================================================

# Full connection string (used by the app / ORM)
# • Bundled Postgres:  keep the default below (hostname "db" = the compose service)
# • Hosted Postgres:   replace with your provider's connection string
DATABASE_URL=postgresql://localhost/openpieces

# =============================================================================
# PostgreSQL — only needed when COMPOSE_PROFILES=with-db
# =============================================================================
POSTGRES_USER=openpieces
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=openpieces


# =============================================================================
# Connection Pool Sizing
#
# Tune these to match your PostgreSQL max_connections setting.
# Rule of thumb: sum of all pools + ~20 headroom < PostgreSQL max_connections
# =============================================================================
# Maximum connections for the Next.js app's postgres-js pool (default: 5)
DB_POOL_MAX=5

# Maximum connections for the worker's pg-boss internal pool (default: 5)
PG_BOSS_POOL_SIZE=5
# Max concurrent jobs pg-boss will process (default: 10)
PG_BOSS_CONCURRENCY=10

# =============================================================================
# Auth.js v5 — required for session signing
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================
AUTH_SECRET=change-me-to-a-random-secret

# =============================================================================
# Internal Ports — used by services to reach each other inside the Docker network
# =============================================================================
# The host port you want to reach the app on (container internally uses 3141)
APP_PORT=3141
OPENCODE_PORT=4096

# =============================================================================
# Next.js — public variables are exposed to the browser (prefix NEXT_PUBLIC_)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:${APP_PORT}

# =============================================================================
# OpenCode Server
# =============================================================================
OPENCODE_INTERNAL_URL=http://opencode:${OPENCODE_PORT}
OPENCODE_SERVER_PASSWORD=change-me-to-a-secure-password

# =============================================================================
# OpenPieces Internal URL
# =============================================================================
# Used by the OpenCode container to authenticate against the internal /api/secrets endpoint.
OPENPIECES_INTERNAL_URL=http://app:${APP_PORT}

# =============================================================================
# AI
# =============================================================================
AI_GATEWAY_API_KEY=change-me-before-deploying

# =============================================================================
# Tavily Web Search
# =============================================================================
TAVILY_API_KEY=

# =============================================================================
# Secrets Encryption Key
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =============================================================================
SECRETS_ENCRYPTION_KEY=change-me-to-a-random-secret

# =============================================================================
# Internal API key
# =============================================================================
# Used by the OpenCode container to authenticate against the internal /api/secrets endpoint.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_API_KEY=change-me-to-a-random-internal-secret

# =============================================================================
# Debugging & Logging
# =============================================================================
# Set to true to enable request logging and console mirroring for service logs
DEBUG_LOGS=true
# Set to true to enable detailed SQL query logging
DB_LOGGING=false

# =============================================================================
# OpenPieces Hub OAuth
# =============================================================================
# API key generated from your OpenPieces Hub profile (/profile)
OPENPIECES_HUB_CLIENT_ID=op_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL of the OpenPieces Hub
OPENPIECES_HUB_URL=https://openpieces.com

# =============================================================================
# Service Domain — used by Traefik for routing and TLS certificate resolution
# =============================================================================
# Set this to the domain you want your services to run on (e.g. sub.example.com)
SERVICE_DOMAIN=sub.example.com
# Regex-escaped version of SERVICE_DOMAIN (dots escaped with \\.) for Traefik wildcard routing
SERVICE_DOMAIN_REGEX_ESCAPED=example\.com # For main level domains
# SERVICE_DOMAIN_REGEX_ESCAPED=sub\.example\.com # For sub domains
